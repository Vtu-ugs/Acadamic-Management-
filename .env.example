# Copy to `.env` (git-ignored) — docker-compose.yml reads these at build/run.
# For any real deployment, set strong unique values. See SECURITY.md.

# MySQL root password (used by the db container AND the backend to connect).
DB_PASSWORD=office_dev_pw
DB_NAME=office_management
DB_USER=root

# Secret used to sign login JWTs. MUST be a long random string in production
# (>= 32 chars). Generate one, e.g.:  openssl rand -hex 32
JWT_SECRET=dev-only-jwt-secret-change-me-in-dotenv-3b8f2a

# Origin(s) the browser app is served from (comma-separated). For the Docker
# stack this is the frontend URL.
CORS_ORIGIN=http://localhost:8080
