# Copy to .env and fill in real values (never commit .env)

# development | production. In production the server refuses to boot with a
# weak/default JWT_SECRET or an empty DB_PASSWORD (see src/config/env.js).
NODE_ENV=development
PORT=4000

DB_HOST=localhost
DB_PORT=3306
DB_NAME=office_management
DB_USER=root
# Docker MySQL 8 (docker-compose.yml) uses: office_dev_pw
# XAMPP MariaDB uses an empty password. Set to match whichever you run.
# Empty passwords are rejected when NODE_ENV=production.
DB_PASSWORD=your_password_here

# Comma-separated origins allowed by CORS (the React dev server, etc.)
CORS_ORIGIN=http://localhost:5173

# Secret used to sign login JWTs. MUST be a long random string (>= 32 chars) in
# production. Generate one:  openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h
