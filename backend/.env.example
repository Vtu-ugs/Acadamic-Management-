# Copy to .env and fill in real values (never commit .env)
PORT=4000

DB_HOST=localhost
DB_PORT=3306
DB_NAME=office_management
DB_USER=root
# Docker MySQL 8 (docker-compose.yml) uses: office_dev_pw
# XAMPP MariaDB uses an empty password. Set to match whichever you run.
DB_PASSWORD=your_password_here

# Comma-separated origins allowed by CORS (the React dev server, etc.)
CORS_ORIGIN=http://localhost:5173

# Secret used to sign login JWTs — set to a long random string in production
JWT_SECRET=change-me-to-a-long-random-string
